# ==============================================================================
# CYMBAL AGENTIC SUITE - ROOT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Cloud & Vertex AI Configuration
# ------------------------------------------------------------------------------
# Required for Gemini 3.7 Flash model invocation, Places API grounding, and BigQuery
GOOGLE_CLOUD_PROJECT=cymbal-hackathon-2026
GEMINI_API_KEY=your_gemini_api_key_here
VERTEX_AI_LOCATION=us-central1

# ------------------------------------------------------------------------------
# 2. Service Ports & Network Binding
# ------------------------------------------------------------------------------
PORT=8080
STOREFRONT_PORT=3000
BACKEND_PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 3. Agent Runtime & Persistence (Long Horizon Agent)
# ------------------------------------------------------------------------------
# In local development without Cloud SQL / Vertex Agent Engine, in-memory or sqlite is used
USE_IN_MEMORY_SESSION=true
USE_IN_MEMORY_TASK_STORE=true
# Optional DB URLs for persistent task/session tracking:
# SESSION_DB_URL=sqlite+aiosqlite:///.data/lha_sessions.db
# TASK_DB_URL=sqlite+aiosqlite:///.data/lha_tasks.db

# ------------------------------------------------------------------------------
# 4. Security, Auth & Inbound Webhooks
# ------------------------------------------------------------------------------
# Webhook secret for UCP HMAC-SHA256 signature verification
UCP_WEBHOOK_SECRET=cymbal_demo_ucp_secret_2026
# Enforcement flag for webhook cryptographic verification
ENFORCE_WEBHOOK_SIGNATURES=false
# Internal API key for telemetry event bus
INTERNAL_EVENT_API_KEY=cymbal_internal_event_key_2026
# Google Chat interactive card verification token
GCHAT_VERIFICATION_TOKEN=cymbal_gchat_token_2026

# ------------------------------------------------------------------------------
# 5. Service URLs & Cross-Service Discovery
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
AGENT_API_URL=http://localhost:8000
